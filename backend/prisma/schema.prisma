// Prisma schema for ARC backend.
// Run `npm run db:migrate` (or `npx prisma migrate dev --name init`) to apply.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfferStatus {
  pending
  accepted
  cancelled
  expired
}

model Offer {
  id               String      @id @default(uuid())
  nftId            String
  contractAddress  String
  tokenId          String
  offerer          String
  offererUsername  String?
  offererAvatar    String?
  price            String
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  status           OfferStatus @default(pending)
  onChainOfferId   String?

  @@index([nftId])
  @@index([offerer])
  @@index([status, expiresAt])
}
