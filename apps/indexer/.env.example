# @arc/indexer skeleton config

NODE_ENV=development
PORT=3001

# CORS (comma-separated allowlist)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Arc testnet RPC (when listener slice lands)
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_PASSPORT_ADDRESS=
ARC_ATTESTATION_REGISTRY_ADDRESS=

# Error tracking (optional, soft-dep)
SENTRY_DSN=
