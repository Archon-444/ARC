{
  "name": "@arc/trust-api",
  "version": "0.0.1",
  "private": true,
  "description": "ARC trust-read API. Express, facilitator-backed x402 paywall on Base mainnet USDC, reads scoreV1 from @arc/trust-core.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "smoke": "ts-node scripts/smoke.ts",
    "smoke:paid-mock": "ts-node scripts/paid-mock.ts",
    "smoke:paid-live": "ts-node scripts/paid-smoke.ts"
  },
  "dependencies": {
    "@arc/trust-core": "*",
    "@arc/x402-client": "*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "viem": "^2.48.1"
  }
}
