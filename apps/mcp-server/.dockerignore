# Keep the build context lean. Anything not listed here is copied into
# the image during `docker build`, so excluding node_modules and dist
# matters for both speed and reproducibility (the build stage installs
# fresh and recompiles from src).

node_modules
**/node_modules
dist
**/dist
.git
.gitignore
*.md
!apps/mcp-server/README.md
!apps/mcp-server/DEPLOY.md
.env
.env.*
test
**/test
e2e
**/e2e
*.log
coverage
.next
out
