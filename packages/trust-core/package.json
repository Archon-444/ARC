{
  "name": "@arc/trust-core",
  "version": "0.0.1",
  "private": true,
  "description": "ARC trust scoring engine and cache helpers. Pure functions consumable by the frontend, the trust-api, and the MCP server.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scoring/v1-heuristic": {
      "types": "./dist/scoring/v1-heuristic.d.ts",
      "default": "./dist/scoring/v1-heuristic.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  }
}
