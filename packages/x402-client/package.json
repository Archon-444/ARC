{
  "name": "@arc/x402-client",
  "version": "0.0.1",
  "private": true,
  "description": "Facilitator-backed x402 (HTTP 402 Payment Required) middleware and types for ARC trust-api. Resource-server side only — no key custody, no client wallet.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./facilitator": {
      "types": "./dist/facilitator.d.ts",
      "default": "./dist/facilitator.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./sign": {
      "types": "./dist/sign.d.ts",
      "default": "./dist/sign.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "typescript": "^5.9.3"
  }
}
