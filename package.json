{
  "name": "arc-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ARC — trust, identity, and editorial-verification layer for Circle-native agent commerce.",
  "workspaces": [
    "contracts",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace arcmarket-frontend run dev",
    "build:web": "npm --workspace arcmarket-frontend run build",
    "test:web": "npm --workspace arcmarket-frontend test",
    "type-check:web": "npm --workspace arcmarket-frontend run type-check",
    "lint:web": "npm --workspace arcmarket-frontend run lint",
    "test:trust-core": "npm --workspace @arc/trust-core test",
    "type-check:trust-core": "npm --workspace @arc/trust-core run type-check",
    "type-check:x402-client": "npm --workspace @arc/x402-client run type-check",
    "build:x402-client": "npm --workspace @arc/x402-client run build",
    "dev:trust-api": "npm --workspace @arc/trust-api run dev",
    "build:trust-api": "npm --workspace @arc/trust-api run build",
    "type-check:trust-api": "npm --workspace @arc/trust-api run type-check",
    "smoke:trust-api": "npm --workspace @arc/trust-api run smoke",
    "smoke:trust-api:paid-mock": "npm --workspace @arc/trust-api run smoke:paid-mock",
    "smoke:trust-api:paid-live": "npm --workspace @arc/trust-api run smoke:paid-live",
    "dev:mcp-server": "npm --workspace @arc/mcp-server run dev",
    "build:mcp-server": "npm --workspace @arc/mcp-server run build",
    "type-check:mcp-server": "npm --workspace @arc/mcp-server run type-check",
    "test:mcp-server": "npm --workspace @arc/mcp-server test",
    "build:passport-sdk": "npm --workspace @arc/passport-sdk run build",
    "type-check:passport-sdk": "npm --workspace @arc/passport-sdk run type-check",
    "test:passport-sdk": "npm --workspace @arc/passport-sdk test",
    "build:attestations": "npm --workspace @arc/attestations run build",
    "type-check:attestations": "npm --workspace @arc/attestations run type-check",
    "test:attestations": "npm --workspace @arc/attestations test",
    "build:attestation-reader": "npm --workspace @arc/attestation-reader run build",
    "type-check:attestation-reader": "npm --workspace @arc/attestation-reader run type-check",
    "test:attestation-reader": "npm --workspace @arc/attestation-reader test",
    "check-passport-contracts": "npm --workspace contracts run check-passport",
    "check-trust-contracts": "npm --workspace contracts run check-contracts",
    "test:packages": "npm --workspaces --if-present test",
    "lint:boundary-fixture": "cd apps/web && ! npx eslint __lint_fixture__/should-fail.ts",
    "build:packages": "npm --workspace @arc/trust-core run build && npm --workspace @arc/x402-client run build && npm --workspace @arc/passport-sdk run build && npm --workspace @arc/attestation-reader run build",
    "postinstall": "npm run build:packages --if-present"
  }
}
