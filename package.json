{
  "name": "arc-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ARC — trust, identity, and editorial-verification layer for Circle-native agent commerce.",
  "workspaces": [
    "frontend",
    "backend",
    "contracts",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace frontend run dev",
    "build:web": "npm --workspace frontend run build",
    "test:web": "npm --workspace frontend test",
    "type-check:web": "npm --workspace frontend run type-check",
    "lint:web": "npm --workspace frontend run lint",
    "test:trust-core": "npm --workspace @arc/trust-core test",
    "type-check:trust-core": "npm --workspace @arc/trust-core run type-check",
    "type-check:x402-client": "npm --workspace @arc/x402-client run type-check",
    "build:x402-client": "npm --workspace @arc/x402-client run build",
    "dev:trust-api": "npm --workspace @arc/trust-api run dev",
    "build:trust-api": "npm --workspace @arc/trust-api run build",
    "type-check:trust-api": "npm --workspace @arc/trust-api run type-check",
    "smoke:trust-api": "npm --workspace @arc/trust-api run smoke",
    "smoke:trust-api:paid-mock": "npm --workspace @arc/trust-api run smoke:paid-mock",
    "smoke:trust-api:paid-live": "npm --workspace @arc/trust-api run smoke:paid-live",
    "dev:mcp-server": "npm --workspace @arc/mcp-server run dev",
    "build:mcp-server": "npm --workspace @arc/mcp-server run build",
    "type-check:mcp-server": "npm --workspace @arc/mcp-server run type-check",
    "test:mcp-server": "npm --workspace @arc/mcp-server test",
    "test:packages": "npm --workspaces --if-present test"
  }
}
